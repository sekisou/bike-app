確認すべきポイント
1️⃣ ブラウザの開発者ツールでエラー確認
F12キーを押して開発者ツールを開く
Consoleタブを確認
エラーメッセージがあれば教えてください
2️⃣ 地図エリアの背景色
地図のコンテナに灰色の背景を設定しました。もし灰色の四角だけが表示されている場合は、APIキーまたはネットワークの問題です。

3️⃣ インターネット接続
Geolonia APIはインターネット接続が必要です。オフラインでは動作しません。

もし地図が全く表示されない場合は、代わりにLeaflet + OpenStreetMap（APIキー不要、確実に動作）に変更することをお勧めします。変更しますか？



セッション制限に達しました ∙ 18:00にリセット
アップグレード





<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>バイク安全運転支援アプリ</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Geolonia Embed API -->
    <script src="https://cdn.geolonia.com/v1/embed?geolonia-api-key=3356f34b-ff06-4d95-ac0e-bc51981ebf64"></script>
    <style>
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        .animate-spin {
            animation: spin 1s linear infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: .5; }
        }
        .animate-pulse {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        /* Geolonia地図のスタイル */
        .geolonia {
            width: 100%;
            height: 400px;
            display: block;
        }
        .geolonia canvas {
            outline: none;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 min-h-screen p-4">
    <div class="max-w-4xl mx-auto">
        <!-- ヘッダー -->
        <div class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl shadow-2xl p-6 mb-6 border border-slate-700">
            <div class="flex items-center gap-3 mb-4">
                <div class="bg-gradient-to-br from-red-500 to-orange-600 p-3 rounded-xl shadow-lg">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-white">バイク安全運転支援</h1>
                    <p class="text-sm text-slate-300">風速・傾斜・路面状況をチェック</p>
                </div>
            </div>

            <!-- 現在地取得ボタン -->
            <button
                id="getLocationBtn"
                class="w-full bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 disabled:bg-gray-600 text-white font-semibold py-3 px-6 rounded-xl flex items-center justify-center gap-2 transition-all shadow-lg"
            >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                </svg>
                <span>現在地を取得</span>
            </button>

            <!-- 手動入力オプション -->
            <div class="mt-4 p-3 bg-slate-700/50 border border-slate-600 rounded-lg">
                <p class="text-sm font-semibold text-slate-200 mb-2">手動で位置を入力:</p>
                <div class="flex gap-2">
                    <input 
                        type="number" 
                        id="manualLat" 
                        placeholder="緯度 (例: 35.6812)" 
                        step="0.000001"
                        class="flex-1 px-3 py-2 bg-slate-800 border border-slate-600 text-white rounded-lg text-sm focus:ring-2 focus:ring-blue-500"
                    >
                    <input 
                        type="number" 
                        id="manualLon" 
                        placeholder="経度 (例: 139.7671)" 
                        step="0.000001"
                        class="flex-1 px-3 py-2 bg-slate-800 border border-slate-600 text-white rounded-lg text-sm focus:ring-2 focus:ring-blue-500"
                    >
                </div>
                <button
                    id="useManualBtn"
                    class="w-full mt-2 bg-slate-600 hover:bg-slate-500 text-white text-sm font-semibold py-2 px-4 rounded-lg transition-colors"
                >
                    手動で設定
                </button>
            </div>

            <!-- 位置情報表示 -->
            <div id="locationInfo" class="hidden mt-4 p-4 bg-green-900/30 border border-green-700 rounded-xl">
                <div class="flex items-start gap-2">
                    <svg class="w-5 h-5 text-green-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <div class="text-sm">
                        <p class="font-semibold text-green-300">位置情報を取得しました</p>
                        <p class="text-green-200" id="coordsText"></p>
                    </div>
                </div>
            </div>

            <!-- 安全情報取得ボタン -->
            <button
                id="checkSafetyBtn"
                class="hidden w-full mt-4 bg-gradient-to-r from-orange-600 to-red-600 hover:from-orange-700 hover:to-red-700 disabled:bg-gray-600 text-white font-semibold py-3 px-6 rounded-xl flex items-center justify-center gap-2 transition-all shadow-lg"
            >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                <span>安全情報をチェック</span>
            </button>

            <!-- エラー表示 -->
            <div id="errorMsg" class="hidden mt-4 p-4 bg-red-900/30 border border-red-700 rounded-xl">
                <div class="flex items-start gap-2">
                    <svg class="w-5 h-5 text-red-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <p class="text-sm text-red-200" id="errorText"></p>
                </div>
            </div>
        </div>

        <!-- 安全情報ダッシュボード -->
        <div id="safetyDashboard" class="hidden space-y-4">
            <!-- 地図表示 -->
            <div class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl shadow-2xl p-6 border border-slate-700">
                <div class="flex items-center gap-3 mb-4">
                    <div class="bg-green-600 p-3 rounded-xl">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.553-.894L9 7m0 0l6-3.446M9 7v10m0 0l6 3.446m-6-3.446L3 7m6 0l6-3.446m0 0A11.953 11.953 0 0121 12a11.954 11.954 0 01-9-8.946m0 0L9 7"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-white">周辺地図と駐車場</h3>
                </div>
                <div class="rounded-lg overflow-hidden border border-slate-600" style="width: 100%; height: 400px;">
                    <div 
                        class="geolonia" 
                        data-lat="35.6812" 
                        data-lng="139.7671" 
                        data-zoom="14"
                        data-marker="off"
                        data-navigation-control="on"
                        data-geolocate-control="off"
                        data-gesture-handling="off"
                        style="width: 100%; height: 100%;"
                    ></div>
                </div>
                <p class="text-xs text-slate-400 mt-2">📍現在地 / 🅿️駐車場</p>
            </div>
            <!-- 総合安全レベル -->
            <div id="safetyLevel" class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl shadow-2xl p-6 border border-slate-700">
                <div class="text-center">
                    <h2 class="text-lg font-bold text-slate-300 mb-3">総合安全レベル</h2>
                    <div id="safetyIndicator" class="text-6xl font-bold mb-2"></div>
                    <p id="safetyMessage" class="text-lg font-semibold"></p>
                    <p id="safetyAdvice" class="text-sm text-slate-400 mt-2"></p>
                </div>
            </div>

            <!-- 風速情報 -->
            <div class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl shadow-2xl p-6 border border-slate-700">
                <div class="flex items-center gap-3 mb-4">
                    <div class="bg-blue-600 p-3 rounded-xl">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-white">風速情報</h3>
                </div>
                <div id="windInfo" class="space-y-2">
                    <div class="flex justify-between items-center p-3 bg-slate-700/50 rounded-lg">
                        <span class="text-slate-300">風速</span>
                        <span id="windSpeed" class="font-bold text-white text-lg">--</span>
                    </div>
                    <div class="flex justify-between items-center p-3 bg-slate-700/50 rounded-lg">
                        <span class="text-slate-300">風向</span>
                        <span id="windDirection" class="font-bold text-white">--</span>
                    </div>
                    <div class="flex justify-between items-center p-3 bg-slate-700/50 rounded-lg">
                        <span class="text-slate-300">突風</span>
                        <span id="windGust" class="font-bold text-white">--</span>
                    </div>
                    <div id="windWarning" class="hidden mt-3 p-3 bg-orange-900/30 border border-orange-600 rounded-lg">
                        <p class="text-sm text-orange-300 font-semibold"></p>
                    </div>
                </div>
            </div>

            <!-- 傾斜・地形情報 -->
            <div class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl shadow-2xl p-6 border border-slate-700">
                <div class="flex items-center gap-3 mb-4">
                    <div class="bg-purple-600 p-3 rounded-xl">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21l18-18M3 10l7-7 4 4 7-7"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-white">傾斜・地形情報</h3>
                </div>
                <div id="terrainInfo" class="space-y-2">
                    <div class="flex justify-between items-center p-3 bg-slate-700/50 rounded-lg">
                        <span class="text-slate-300">標高</span>
                        <span id="elevation" class="font-bold text-white">--</span>
                    </div>
                    <div class="flex justify-between items-center p-3 bg-slate-700/50 rounded-lg">
                        <span class="text-slate-300">周辺の傾斜</span>
                        <span id="slope" class="font-bold text-white">--</span>
                    </div>
                    <div id="terrainWarning" class="hidden mt-3 p-3 bg-yellow-900/30 border border-yellow-600 rounded-lg">
                        <p class="text-sm text-yellow-300 font-semibold"></p>
                    </div>
                </div>
            </div>

            <!-- 路面・気象情報 -->
            <div class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl shadow-2xl p-6 border border-slate-700">
                <div class="flex items-center gap-3 mb-4">
                    <div class="bg-emerald-600 p-3 rounded-xl">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-white">路面・気象情報</h3>
                </div>
                <div id="weatherInfo" class="space-y-2">
                    <div class="flex justify-between items-center p-3 bg-slate-700/50 rounded-lg">
                        <span class="text-slate-300">気温</span>
                        <span id="temperature" class="font-bold text-white">--</span>
                    </div>
                    <div class="flex justify-between items-center p-3 bg-slate-700/50 rounded-lg">
                        <span class="text-slate-300">湿度</span>
                        <span id="humidity" class="font-bold text-white">--</span>
                    </div>
                    <div class="flex justify-between items-center p-3 bg-slate-700/50 rounded-lg">
                        <span class="text-slate-300">天気</span>
                        <span id="weather" class="font-bold text-white">--</span>
                    </div>
                    <div class="flex justify-between items-center p-3 bg-slate-700/50 rounded-lg">
                        <span class="text-slate-300">降水量</span>
                        <span id="precipitation" class="font-bold text-white">--</span>
                    </div>
                    <div id="weatherWarning" class="hidden mt-3 p-3 bg-red-900/30 border border-red-600 rounded-lg">
                        <p class="text-sm text-red-300 font-semibold"></p>
                    </div>
                </div>
            </div>

            <!-- 駐車場検索ボタン -->
            <button
                id="searchParkingBtn"
                class="w-full bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-semibold py-3 px-6 rounded-xl flex items-center justify-center gap-2 transition-all shadow-lg"
            >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                <span>近くの駐車場を検索</span>
            </button>

            <!-- 駐車場検索結果 -->
            <div id="parkingResults" class="hidden bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl shadow-2xl p-6 border border-slate-700">
                <h3 class="text-xl font-bold text-white mb-4" id="parkingTitle"></h3>
                <div id="parkingList" class="space-y-3"></div>
            </div>
        </div>

        <!-- 使い方 -->
        <div class="mt-6 bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl shadow-2xl p-6 border border-slate-700">
            <h3 class="font-bold text-white mb-3">使い方</h3>
            <ol class="list-decimal list-inside space-y-2 text-sm text-slate-300">
                <li>現在地を取得または手動で位置を入力</li>
                <li>「安全情報をチェック」で風速・傾斜・路面状況を確認</li>
                <li>総合安全レベルで運転の可否を判断</li>
                <li>必要に応じて近くの駐車場を検索</li>
            </ol>
            <div class="mt-4 p-3 bg-yellow-900/30 border border-yellow-600 rounded-lg">
                <p class="text-xs text-yellow-300 font-semibold mb-1">⚠️ 安全運転のために</p>
                <ul class="text-xs text-yellow-200 space-y-1">
                    <li>• 風速10m/s以上: 運転注意</li>
                    <li>• 風速15m/s以上: 運転非推奨</li>
                    <li>• 雨天時: 路面滑りやすく注意</li>
                    <li>• 急な傾斜: 停車・発進時に注意</li>
                </ul>
            </div>
        </div>
    </div>

    <script>
        let currentLocation = null;
        const getLocationBtn = document.getElementById('getLocationBtn');
        const useManualBtn = document.getElementById('useManualBtn');
        const checkSafetyBtn = document.getElementById('checkSafetyBtn');
        const searchParkingBtn = document.getElementById('searchParkingBtn');
        const locationInfo = document.getElementById('locationInfo');
        const errorMsg = document.getElementById('errorMsg');
        const safetyDashboard = document.getElementById('safetyDashboard');

        // 地図を初期化
        // 地図の中心とズームを更新
        function initMap(lat, lng) {
            const mapElements = document.querySelectorAll('.geolonia');
            mapElements.forEach(mapElement => {
                mapElement.setAttribute('data-lat', lat);
                mapElement.setAttribute('data-lng', lng);
                mapElement.setAttribute('data-zoom', '14');
                mapElement.setAttribute('data-marker', 'on');
                mapElement.setAttribute('data-marker-color', '#3B82F6');
            });

            // Geoloniaは自動的に属性の変更を検知して地図を更新
        }

        // 現在地マーカーを追加（Geoloniaの自動マーカーを使用）
        function addCurrentLocationMarker(lat, lng) {
            // Geoloniaのdata-marker属性で自動的にマーカーが表示される
        }

        // 駐車場マーカーを追加（現在は地図の自動表示のみ）
        function addParkingMarkers(parkingData) {
            // 駐車場情報を表示（マーカーはGoogleマップリンクで対応）
            console.log('駐車場データ:', parkingData);
        }

        // 手動入力
        useManualBtn.addEventListener('click', () => {
            const lat = parseFloat(document.getElementById('manualLat').value);
            const lon = parseFloat(document.getElementById('manualLon').value);

            if (isNaN(lat) || isNaN(lon)) {
                showError('有効な緯度経度を入力してください');
                return;
            }

            setLocation(lat, lon, 0);
        });

        // 現在地取得
        getLocationBtn.addEventListener('click', () => {
            if (!navigator.geolocation) {
                showError('位置情報に対応していません。手動入力をご利用ください。');
                return;
            }

            getLocationBtn.disabled = true;
            getLocationBtn.innerHTML = '<svg class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg><span>取得中...</span>';

            navigator.geolocation.getCurrentPosition(
                (position) => {
                    setLocation(position.coords.latitude, position.coords.longitude, position.coords.accuracy);
                    resetLocationButton();
                },
                (err) => {
                    showError('位置情報の取得に失敗しました');
                    resetLocationButton();
                },
                { enableHighAccuracy: true, timeout: 15000 }
            );
        });

        function setLocation(lat, lon, accuracy) {
            currentLocation = { latitude: lat, longitude: lon, accuracy: accuracy };
            document.getElementById('coordsText').textContent = 
                `緯度: ${lat.toFixed(6)}, 経度: ${lon.toFixed(6)}`;
            locationInfo.classList.remove('hidden');
            checkSafetyBtn.classList.remove('hidden');
            errorMsg.classList.add('hidden');
        }

        function resetLocationButton() {
            getLocationBtn.disabled = false;
            getLocationBtn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg><span>現在地を取得</span>';
        }

        // 安全情報チェック
        checkSafetyBtn.addEventListener('click', async () => {
            if (!currentLocation) return;

            checkSafetyBtn.disabled = true;
            checkSafetyBtn.innerHTML = '<svg class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg><span>チェック中...</span>';

            try {
                // Open-Meteo API（無料の気象API）
                const weatherUrl = `https://api.open-meteo.com/v1/forecast?latitude=${currentLocation.latitude}&longitude=${currentLocation.longitude}&current=temperature_2m,relative_humidity_2m,precipitation,weather_code,wind_speed_10m,wind_direction_10m,wind_gusts_10m&wind_speed_unit=ms&timezone=Asia/Tokyo`;
                
                const weatherResponse = await fetch(weatherUrl);
                const weatherData = await weatherResponse.json();

                // Open-Elevation API（標高取得）
                const elevationUrl = `https://api.open-elevation.com/api/v1/lookup?locations=${currentLocation.latitude},${currentLocation.longitude}`;
                const elevationResponse = await fetch(elevationUrl);
                const elevationData = await elevationResponse.json();

                displaySafetyInfo(weatherData, elevationData);
                safetyDashboard.classList.remove('hidden');

            } catch (err) {
                showError('安全情報の取得に失敗しました: ' + err.message);
            } finally {
                checkSafetyBtn.disabled = false;
                checkSafetyBtn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg><span>安全情報をチェック</span>';
            }
        });

        function displaySafetyInfo(weather, elevation) {
            const current = weather.current;
            
            // 風速情報
            const windSpeed = current.wind_speed_10m;
            const windGust = current.wind_gusts_10m;
            document.getElementById('windSpeed').textContent = `${windSpeed.toFixed(1)} m/s`;
            document.getElementById('windDirection').textContent = getWindDirection(current.wind_direction_10m);
            document.getElementById('windGust').textContent = `${windGust.toFixed(1)} m/s`;

            const windWarning = document.getElementById('windWarning');
            if (windSpeed >= 15) {
                windWarning.classList.remove('hidden');
                windWarning.querySelector('p').textContent = '⚠️ 強風警報: 運転を控えることを推奨します';
            } else if (windSpeed >= 10) {
                windWarning.classList.remove('hidden');
                windWarning.querySelector('p').textContent = '⚠️ 風が強いです。運転に注意してください';
            } else {
                windWarning.classList.add('hidden');
            }

            // 標高・傾斜情報
            const elev = elevation.results[0].elevation;
            document.getElementById('elevation').textContent = `${elev.toFixed(0)} m`;
            document.getElementById('slope').textContent = '計算中...';
            
            // 簡易的な傾斜判定（標高差で判断）
            if (elev > 500) {
                const terrainWarning = document.getElementById('terrainWarning');
                terrainWarning.classList.remove('hidden');
                terrainWarning.querySelector('p').textContent = '⚠️ 山岳地帯: 急な坂道に注意してください';
            }

            // 気象情報
            document.getElementById('temperature').textContent = `${current.temperature_2m.toFixed(1)}°C`;
            document.getElementById('humidity').textContent = `${current.relative_humidity_2m}%`;
            document.getElementById('weather').textContent = getWeatherDescription(current.weather_code);
            document.getElementById('precipitation').textContent = `${current.precipitation} mm`;

            const weatherWarning = document.getElementById('weatherWarning');
            if (current.precipitation > 0) {
                weatherWarning.classList.remove('hidden');
                weatherWarning.querySelector('p').textContent = '⚠️ 雨天: 路面が滑りやすくなっています';
            } else {
                weatherWarning.classList.add('hidden');
            }

            // 総合安全レベル
            calculateSafetyLevel(windSpeed, current.precipitation, current.weather_code);
        }

        function calculateSafetyLevel(windSpeed, precipitation, weatherCode) {
            let safetyScore = 100;
            let warnings = [];

            // 風速による減点
            if (windSpeed >= 15) {
                safetyScore -= 50;
                warnings.push('強風');
            } else if (windSpeed >= 10) {
                safetyScore -= 30;
                warnings.push('風やや強い');
            }

            // 降水による減点
            if (precipitation > 5) {
                safetyScore -= 40;
                warnings.push('大雨');
            } else if (precipitation > 0) {
                safetyScore -= 20;
                warnings.push('雨');
            }

            const indicator = document.getElementById('safetyIndicator');
            const message = document.getElementById('safetyMessage');
            const advice = document.getElementById('safetyAdvice');

            if (safetyScore >= 80) {
                indicator.textContent = '✅';
                indicator.className = 'text-6xl font-bold mb-2 text-green-400';
                message.textContent = '安全';
                message.className = 'text-lg font-semibold text-green-300';
                advice.textContent = '運転に適した気象条件です';
            } else if (safetyScore >= 50) {
                indicator.textContent = '⚠️';
                indicator.className = 'text-6xl font-bold mb-2';
                message.textContent = '注意';
                message.className = 'text-lg font-semibold text-yellow-300';
                advice.textContent = `${warnings.join('、')}に注意して運転してください`;
            } else {
                indicator.textContent = '🛑';
                indicator.className = 'text-6xl font-bold mb-2';
                message.textContent = '危険';
                message.className = 'text-lg font-semibold text-red-300';
                advice.textContent = `${warnings.join('、')}により運転は推奨されません`;
            }
        }

        function getWindDirection(deg) {
            const directions = ['北', '北東', '東', '南東', '南', '南西', '西', '北西'];
            const index = Math.round(deg / 45) % 8;
            return directions[index];
        }

        function getWeatherDescription(code) {
            const weatherCodes = {
                0: '快晴', 1: '晴れ', 2: '曇り', 3: '曇り',
                45: '霧', 48: '霧', 51: '小雨', 53: '雨',
                55: '大雨', 61: '小雨', 63: '雨', 65: '大雨',
                71: '小雪', 73: '雪', 75: '大雪',
                95: '雷雨', 96: '雷雨', 99: '雷雨'
            };
            return weatherCodes[code] || '不明';
        }

        // 駐車場検索
        searchParkingBtn.addEventListener('click', async () => {
            if (!currentLocation) return;

            searchParkingBtn.disabled = true;
            searchParkingBtn.innerHTML = '<svg class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg><span>検索中...</span>';

            try {
                const query = `[out:json][timeout:25];(node["amenity"="parking"](around:2000,${currentLocation.latitude},${currentLocation.longitude});node["amenity"="motorcycle_parking"](around:2000,${currentLocation.latitude},${currentLocation.longitude});way["amenity"="parking"](around:2000,${currentLocation.latitude},${currentLocation.longitude}););out body center;`;

                const response = await fetch('https://overpass-api.de/api/interpreter', {
                    method: 'POST',
                    body: query
                });

                const data = await response.json();
                displayParkingResults(data.elements);

            } catch (err) {
                showError('駐車場検索に失敗しました');
            } finally {
                searchParkingBtn.disabled = false;
                searchParkingBtn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg><span>近くの駐車場を検索</span>';
            }
        });

        function displayParkingResults(elements) {
            const results = elements.map(el => {
                const lat = el.lat || el.center?.lat;
                const lon = el.lon || el.center?.lon;
                const distance = calculateDistance(currentLocation.latitude, currentLocation.longitude, lat, lon);
                return {
                    id: el.id,
                    name: el.tags?.name || '駐車場',
                    type: el.tags?.amenity === 'motorcycle_parking' ? 'バイク専用' : '一般',
                    distance: distance,
                    lat: lat,
                    lon: lon,
                    fee: el.tags?.fee === 'yes' ? '有料' : el.tags?.fee === 'no' ? '無料' : '不明'
                };
            });

            results.sort((a, b) => a.distance - b.distance);
            
            const parkingList = document.getElementById('parkingList');
            parkingList.innerHTML = '';
            
            if (results.length === 0) {
                document.getElementById('parkingResults').classList.add('hidden');
                showError('周辺に駐車場が見つかりませんでした');
                return;
            }
            
            results.slice(0, 5).forEach((p, i) => {
                const div = document.createElement('div');
                div.className = 'p-4 bg-slate-700/50 rounded-xl hover:bg-slate-700 transition-colors';
                div.innerHTML = `
                    <div class="flex justify-between items-center">
                        <div>
                            <h4 class="font-bold text-white">${i+1}. ${p.name}</h4>
                            <p class="text-sm text-slate-300">${p.type} • ${p.fee}</p>
                        </div>
                        <div class="text-right">
                            <p class="font-bold text-blue-400">${p.distance}m</p>
                            <button onclick="window.open('https://www.google.com/maps/search/?api=1&query=${p.lat},${p.lon}', '_blank')" class="mt-1 text-xs bg-blue-600 hover:bg-blue-700 text-white px-3 py-1 rounded-lg">地図</button>
                        </div>
                    </div>
                `;
                parkingList.appendChild(div);
            });

            document.getElementById('parkingTitle').textContent = `近くの駐車場 (${results.length}件)`;
            document.getElementById('parkingResults').classList.remove('hidden');
        }

        function calculateDistance(lat1, lon1, lat2, lon2) {
            const R = 6371;
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;
            const a = Math.sin(dLat/2) * Math.sin(dLat/2) + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLon/2) * Math.sin(dLon/2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
            return (R * c * 1000).toFixed(0);
        }

        function showError(message) {
            document.getElementById('errorText').textContent = message;
            errorMsg.classList.remove('hidden');
        }
    </script>
</body>
</html>
